{
  "name": "Video Knowledge API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {},
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Video Analysis API",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "postStartCommand": "(nohup python main.py > /tmp/video-knowledge-api.log 2>&1 &)"
}
