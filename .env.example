# Server
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=600
MAX_CONCURRENT_TASKS=2

# Local storage
COOKIE_STORE_PATH=.secrets/cookies.json
CACHE_ROOT=.cache/video-knowledge-api
KEEP_CACHE=false

# GLM is only required when fallback_to_glm_stt or include_visual_analysis is enabled.
GLM_API_KEY=

# Optional alias supported by the Zhipu SDK ecosystem.
# ZHIPUAI_API_KEY=

# Optional advanced yt-dlp cookie file in Netscape format.
# YTDLP_COOKIES_FILE=.secrets/bilibili.cookies.txt
