# 服务启动配置：初学者通常不需要修改这一组。
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=600
MAX_CONCURRENT_TASKS=2

# 本地存储配置：用于保存 Cookie、缓存文件和临时文件，通常不需要修改。
COOKIE_STORE_PATH=.secrets/cookies.json
CACHE_ROOT=.cache/video-knowledge-api
KEEP_CACHE=false

# 智谱 GLM API Key：必填。
# 当前项目默认开启 GLM-ASR 和视频画面理解，会使用这个 Key。
# 示例：GLM_API_KEY=xxxxxxxxxxxxxxxx
GLM_API_KEY=

# Bilibili Cookie：必填。
# 读取 Bilibili 官方字幕、AI 字幕、音频和视频时都会优先使用这份登录态。
# 登录 Bilibili 网页版后，从浏览器开发者工具复制完整 Cookie，粘贴到等号后面。
# 示例：BILIBILI_COOKIE="SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx"
BILIBILI_COOKIE=

# 智谱 SDK 兼容变量：通常不用填；如果已经习惯使用 ZHIPUAI_API_KEY，也可以填这里。
# ZHIPUAI_API_KEY=

# 进阶用法：指定 Netscape 格式 Cookie 文件。初学者不用配置。
# YTDLP_COOKIES_FILE=.secrets/bilibili.cookies.txt
