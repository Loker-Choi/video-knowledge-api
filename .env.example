# 基础配置：一般不用改。
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=600

# 临时缓存位置：一般不用改。
CACHE_ROOT=.cache/video-knowledge-api
KEEP_CACHE=false

# 必填：智谱 API Key。
# 把等号后面换成自己的 Key。
# 示例：GLM_API_KEY=xxxxxxxxxxxxxxxx
GLM_API_KEY=

# 必填：Bilibili Cookie。
# 登录 Bilibili 网页版后，从浏览器开发者工具复制完整 Cookie。
# 把完整 Cookie 粘贴到双引号里面。
# 示例：BILIBILI_COOKIE="SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx"
BILIBILI_COOKIE=
